# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore — nunca se sube al repositorio.

# Clave secreta de OpenAI (obligatoria para activar el asistente real)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar (opcional). Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Origen permitido para CORS (opcional). Default: *
# Para producción, pon tu dominio: https://francisconoriega.vercel.app
# ALLOWED_ORIGIN=*
